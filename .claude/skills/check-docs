#!/usr/bin/env bash

# check-docs: Validate documentation completeness and quality
#
# This skill validates the Agent Framework documentation for:
# - Broken internal links (relative paths)
# - ADR references in architecture docs
# - Overview.md links to all drill-down pages
# - Mermaid diagram syntax
# - "[To be documented" placeholders
# - Documentation coverage gaps

set -euo pipefail

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Counters
ERRORS=0
WARNINGS=0
INFO=0

# Get repository root
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

echo -e "${BLUE}=== Documentation Validation ===${NC}"
echo "Repository: $REPO_ROOT"
echo ""

# Function to report error
error() {
    echo -e "${RED}ERROR:${NC} $1"
    ((ERRORS++))
}

# Function to report warning
warning() {
    echo -e "${YELLOW}WARNING:${NC} $1"
    ((WARNINGS++))
}

# Function to report info
info() {
    echo -e "${GREEN}INFO:${NC} $1"
    ((INFO++))
}

# Check 1: Broken internal links in markdown files
echo -e "${BLUE}[1/6] Checking for broken internal links...${NC}"
while IFS= read -r -d '' md_file; do
    # Extract markdown links: [text](path)
    while IFS= read -r link; do
        # Skip external links (http/https)
        if [[ "$link" =~ ^https?:// ]]; then
            continue
        fi

        # Skip anchor-only links (#section)
        if [[ "$link" =~ ^# ]]; then
            continue
        fi

        # Remove anchor if present (path#anchor -> path)
        link_path="${link%%#*}"

        # Resolve relative path
        md_dir="$(dirname "$md_file")"
        target_path="$md_dir/$link_path"

        # Check if target exists
        if [[ ! -e "$target_path" ]]; then
            error "Broken link in $md_file: $link_path (resolved to $target_path)"
        fi
    done < <(grep -oP '\[.*?\]\(\K[^)]+' "$md_file" 2>/dev/null || true)
done < <(find docs -name "*.md" -type f -print0 2>/dev/null)

# Check 2: ADR references in architecture docs
echo -e "${BLUE}[2/6] Checking ADR references in architecture docs...${NC}"
if [[ -d "docs/decisions" ]]; then
    # Get list of ADRs
    adr_count=$(find docs/decisions -name "*.md" ! -name "TEMPLATE.md" -type f | wc -l)

    if [[ $adr_count -gt 0 ]]; then
        # Check if architecture docs reference ADRs
        arch_docs_with_adr=0
        while IFS= read -r -d '' arch_file; do
            if grep -q "ADR-" "$arch_file" 2>/dev/null; then
                ((arch_docs_with_adr++))
            fi
        done < <(find docs/architecture -name "*.md" -type f -print0 2>/dev/null)

        if [[ $arch_docs_with_adr -eq 0 ]]; then
            warning "Found $adr_count ADRs but no architecture docs reference them"
        else
            info "Architecture docs reference ADRs ($arch_docs_with_adr files)"
        fi
    fi
fi

# Check 3: Overview.md links to drill-down pages
echo -e "${BLUE}[3/6] Checking overview.md completeness...${NC}"

# .NET architecture
if [[ -f "docs/architecture/dotnet/overview.md" ]]; then
    dotnet_overview="docs/architecture/dotnet/overview.md"

    # Get all .md files in dotnet/ except overview.md
    while IFS= read -r detail_file; do
        detail_basename="$(basename "$detail_file")"

        # Check if overview.md links to this file
        if ! grep -q "$detail_basename" "$dotnet_overview"; then
            warning ".NET overview.md doesn't link to $detail_basename"
        fi
    done < <(find docs/architecture/dotnet -name "*.md" ! -name "overview.md" -type f)
fi

# Python architecture
if [[ -f "docs/architecture/python/overview.md" ]]; then
    python_overview="docs/architecture/python/overview.md"

    while IFS= read -r detail_file; do
        detail_basename="$(basename "$detail_file")"

        if ! grep -q "$detail_basename" "$python_overview"; then
            warning "Python overview.md doesn't link to $detail_basename"
        fi
    done < <(find docs/architecture/python -name "*.md" ! -name "overview.md" -type f)
fi

# Check 4: Mermaid diagram syntax validation
echo -e "${BLUE}[4/6] Validating mermaid diagrams...${NC}"
while IFS= read -r -d '' md_file; do
    # Extract mermaid code blocks
    in_mermaid=0
    line_num=0

    while IFS= read -r line; do
        ((line_num++))

        # Detect mermaid block start
        if [[ "$line" =~ ^\`\`\`mermaid ]]; then
            in_mermaid=1
            continue
        fi

        # Detect code block end
        if [[ "$line" =~ ^\`\`\`$ ]] && [[ $in_mermaid -eq 1 ]]; then
            in_mermaid=0
            continue
        fi

        # Validate mermaid syntax (basic checks)
        if [[ $in_mermaid -eq 1 ]]; then
            # Check for common syntax errors
            if [[ "$line" =~ ^[[:space:]]*graph[[:space:]]+[^TLR] ]]; then
                error "Invalid mermaid direction in $md_file:$line_num (use TD, TB, LR, RL, BT)"
            fi

            # Check for unclosed brackets in node definitions
            if [[ "$line" =~ \[[^\]]*$ ]] && [[ ! "$line" =~ --> ]]; then
                warning "Potentially unclosed bracket in $md_file:$line_num"
            fi
        fi
    done < "$md_file"
done < <(find docs -name "*.md" -type f -print0 2>/dev/null)

# Check 5: "[To be documented" placeholders
echo -e "${BLUE}[5/6] Checking for documentation placeholders...${NC}"
placeholder_count=0
while IFS= read -r -d '' md_file; do
    count=$(grep -c "\[To be documented" "$md_file" 2>/dev/null || true)
    if [[ $count -gt 0 ]]; then
        warning "Found $count placeholder(s) in $md_file"
        ((placeholder_count += count))
    fi
done < <(find docs -name "*.md" -type f -print0 2>/dev/null)

if [[ $placeholder_count -eq 0 ]]; then
    info "No documentation placeholders found"
fi

# Check 6: Documentation coverage gaps
echo -e "${BLUE}[6/6] Checking documentation coverage...${NC}"

# Check if key documentation files exist
declare -A required_docs=(
    ["docs/architecture/dotnet/overview.md"]="✅"
    ["docs/architecture/dotnet/core-abstractions.md"]="✅"
    ["docs/architecture/dotnet/design-patterns.md"]="✅"
    ["docs/architecture/dotnet/dotnet-build-system.md"]="✅"
    ["dotnet/DEV_SETUP.md"]="✅"
    ["python/DEV_SETUP.md"]="✅"
    ["CLAUDE.md"]="✅"
    [".github/instructions/architecture-dotnet.instructions.md"]="✅"
)

echo ""
echo "Documentation Coverage:"
for doc in "${!required_docs[@]}"; do
    if [[ -f "$doc" ]]; then
        echo -e "  ${GREEN}✓${NC} $doc"
    else
        echo -e "  ${RED}✗${NC} $doc"
        error "Missing required documentation: $doc"
    fi
done

# Summary
echo ""
echo -e "${BLUE}=== Summary ===${NC}"
echo -e "Errors:   ${RED}$ERRORS${NC}"
echo -e "Warnings: ${YELLOW}$WARNINGS${NC}"
echo -e "Info:     ${GREEN}$INFO${NC}"

# Exit code
if [[ $ERRORS -gt 0 ]]; then
    echo -e "${RED}Documentation validation FAILED${NC}"
    exit 1
elif [[ $WARNINGS -gt 0 ]]; then
    echo -e "${YELLOW}Documentation validation PASSED with warnings${NC}"
    exit 0
else
    echo -e "${GREEN}Documentation validation PASSED${NC}"
    exit 0
fi
